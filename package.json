{
  "name": "duck-platformer",
  "version": "0.0.1",
  "description": "A pixel-art platformer about a duck climbing back up her high-rise.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "build:deploy": "npm run check && npm test && npm run build",
    "preview": "npm run build && wrangler dev",
    "check": "tsc",
    "lint": "prettier --check . && eslint --max-warnings 0 . && markdownlint-cli2",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "reaches": "tsx src/sim/reachCli.ts",
    "deploy": "npm run build && wrangler deploy",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jsquash/webp": "1.5.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
